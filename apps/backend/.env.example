# ── Model ─────────────────────────────────────────────────────────────────────
SAVED_MODEL_PATH=models/exports/bisindo_v2_ls/saved_model
LABEL_MAP_PATH=models/exports/bisindo_v2_ls/label_map.json

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: http://localhost:3000
# Production:  https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Supabase JWT ───────────────────────────────────────────────────────────────
# Get from: Supabase dashboard → Settings → API → JWT Secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to true in production to enforce JWT on /predict.
# When false, unauthenticated requests are allowed but forged tokens still rejected.
REQUIRE_AUTH=false
