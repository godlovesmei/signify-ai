# ── Model ────────────────────────────────────────────────────────────────────
# Path to YOLO11 weights (relative to repo root — run uvicorn from there)
MODEL_PATH=models/exports/bisindo_yolo/best.pt
INPUT_SIZE=640
CONFIDENCE_THRESHOLD=0.5

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Replace with your production domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Supabase Auth (optional) ──────────────────────────────────────────────────
# Get JWT_SECRET from: Supabase Dashboard → Project Settings → API → JWT Secret
# Leave empty to run the API without authentication.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Set to true in production to enforce JWT on /predict
REQUIRE_AUTH=false
