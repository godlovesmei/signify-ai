# Set in backend hosting environment, never in the frontend or Git.
# Production does not load .env.dataset.local.
DATASET_ENVIRONMENT=production
DATASET_SUPABASE_URL=https://your-project.supabase.co
DATASET_ANON_KEY=
DATASET_SERVICE_ROLE_KEY=
# Optional with ES256/RS256 (JWKS). Required for legacy HS256 user JWTs.
DATASET_JWT_HS256_SECRET=
DATASET_IDEMPOTENCY_SECRET=
DATASET_ALLOWED_ORIGINS=["https://your-app.vercel.app"]
DATASET_WORK_DIR=/var/data/dataset
DATASET_FFMPEG=ffmpeg
DATASET_FFPROBE=ffprobe
DATASET_PROCESS_MEMORY_MIB=512
DATASET_MAX_PARALLEL_UPLOADS=1
DATASET_REVIEW_WORKFLOW_READY=true
DATASET_REVIEW_TARGET_BUSINESS_DAYS=3
PORT=8001
