# Development only. Copy to .env.dataset.local (gitignored).
DATASET_ENVIRONMENT=local
DATASET_ALLOWED_ORIGINS=["http://localhost:3000"]
# Fill keys ONLY from the isolated local Supabase stack; never copy production .env.
DATASET_SUPABASE_URL=http://127.0.0.1:55431
DATASET_ANON_KEY=
DATASET_SERVICE_ROLE_KEY=
DATASET_JWT_HS256_SECRET=
# Persistent random secret >=32 characters for stable per-owner idempotency IDs.
DATASET_IDEMPOTENCY_SECRET=
# Absolute paths if FFmpeg/FFprobe are not on the local process PATH.
DATASET_FFMPEG=ffmpeg
DATASET_FFPROBE=ffprobe
DATASET_PROCESS_TIMEOUT_SECONDS=15
DATASET_PROCESS_MEMORY_MIB=1024
DATASET_MAX_PARALLEL_UPLOADS=2
DATASET_SIGNED_URL_SECONDS=60
# Internal provisional target; not a promised completion deadline.
# Set false to pause review operations. Membership comes from explicit database grants.
# Assign curator access through profiles.role in Supabase; see docs/Akses_Kurator_Supabase.md.
# With no active curator grants the system reports review as unavailable.
DATASET_REVIEW_WORKFLOW_READY=true
DATASET_REVIEW_TARGET_BUSINESS_DAYS=3
# File maximum remains in the active local video policy (pilot: 16777216 bytes).
# No KB/MB minimum file-size rule is introduced.
